{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Java: compile active file",
            "type": "shell",
            "command": "javac",
            "args": ["-g", "${file}"],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": "$javac",
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}
